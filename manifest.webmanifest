{
  "id": "./",
  "name": "sphere.",
  "short_name": "sphere.",
  "description": "Sua coleção musical pessoal, no seu navegador.",
  "lang": "pt-BR",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./?shared=1#/downloads",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "background_color": "#090a0c",
  "theme_color": "#090a0c",
  "icons": [
    { "src": "./sphere-app-icon-rounded-192.png?v=1", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./sphere-app-icon-rounded-512.png?v=1", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./sphere-app-icon-maskable-512.png?v=8", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
